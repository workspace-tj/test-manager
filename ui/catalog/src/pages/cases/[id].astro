---
import type { ManagedCase } from '../../../../../src/model.ts';
import AppLayout from '../../components/AppLayout.astro';
import { cases, documentById, safeName } from '../../lib/catalog.ts';

export function getStaticPaths() {
  return cases.map((managedCase) => ({ params: { id: managedCase.id }, props: { managedCase } }));
}

const { managedCase } = Astro.props as { managedCase: ManagedCase };
const refs = [managedCase.fields.belongsTo, ...(managedCase.fields.refs ?? [])];
const parameters = managedCase.source === 'vitest' ? managedCase.parameters : undefined;
---
<AppLayout title={managedCase.title} section="cases" rootPrefix="../">
  <h1>{managedCase.title}</h1>
  <p><code>{managedCase.id}</code> · {managedCase.source} · {managedCase.status}</p>
  <h2>所属・分類</h2><pre>{JSON.stringify(managedCase.fields, null, 2)}</pre>
  <h2>条件・理由</h2><pre>{JSON.stringify(managedCase.details, null, 2)}</pre>
  {managedCase.procedure && <Fragment><h2>操作と期待結果</h2><pre>{JSON.stringify(managedCase.procedure, null, 2)}</pre></Fragment>}
  {parameters && <Fragment><h2>each入力表</h2><pre>{JSON.stringify(parameters, null, 2)}</pre></Fragment>}
  <h2>関連する仕様・判断</h2><ul>{refs.map((id) => { const document = documentById.get(id); return document && <li><a href={`../documents/${safeName(document.id)}.html`}>{document.title}</a></li>; })}</ul>
  <h2>ソース</h2><p><code>{managedCase.location.file}:{managedCase.location.line}</code></p><pre>{managedCase.snippet}</pre>
</AppLayout>
