---
import AppLayout from '../../components/AppLayout.astro';
import { cases, catalog, documentById, documents, domainOf, safeName } from '../../lib/catalog.ts';

const values = (select: (item: typeof cases[number]) => unknown): string[] => [...new Set(cases.map(select)
  .filter((value): value is string | number => typeof value === 'string' || typeof value === 'number').map(String))].sort();
const filterFields = Object.entries(catalog.rules.case.fields)
  .filter(([name, rule]) => name !== 'belongsTo' && rule.placement === 'classification' && rule.type !== 'reference-list')
  .map(([name]) => name).sort();
const fieldOptions = (name: string) => {
  const rule = catalog.rules.case.fields[name];
  return values((item) => item.fields[name]).map((value) => ({
    value,
    label: rule?.type === 'enum' || rule?.type === 'integer-enum' ? rule.values[value]?.label ?? value : value,
  }));
};
const filters = [
  { key: 'source', label: '確認手段', options: values((item) => item.source).map((value) => ({ value, label: value })) },
  { key: 'status', label: '定義状態', options: values((item) => item.status).map((value) => ({ value, label: value })) },
  ...filterFields.map((key) => ({ key, label: catalog.rules.case.fields[key]?.label ?? key, options: fieldOptions(key) })),
];
const domains = documents.filter((document) => document.parent === undefined).map((domain) => ({
  domain,
  cases: cases.filter((item) => domainOf(item)?.id === domain.id),
})).filter((entry) => entry.cases.length > 0);
---
<AppLayout title="ケース検索" section="cases" rootPrefix="../">
  <div class="catalog-intro">
    <h1>ケース検索</h1>
    <label class="global-search"><span>検索</span><input id="search" type="search" placeholder="ID、ケース名、featureを検索" /></label>
    <strong><span>{cases.length}</span>ケース</strong>
  </div>
  <div class="catalog-layout">
    <aside class="domain-index">
      <button class="active" type="button" data-domain-filter="" aria-pressed="true"><span>すべて</span><small>{cases.length}</small></button>
      {domains.map(({ domain, cases: domainCases }) => <button type="button" data-domain-filter={domain.id} aria-pressed="false"><span>{domain.title}</span><small>{domainCases.length}</small></button>)}
    </aside>
    <div class="catalog-content">
      <section class="filters">{filters.map((filter) => <label><span>{filter.label}</span><select id={`${filter.key}-filter`} data-filter-key={filter.key}><option value="">すべて</option>{filter.options.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>)}</section>
      <p class="result-summary" id="result-summary" aria-live="polite">{cases.length}ケース</p>
      <div id="domain-groups">{domains.map(({ domain, cases: domainCases }) => <section class="domain-group" data-domain-group={domain.id}>
        <header><h2>{domain.title}</h2><span>{domainCases.length}ケース</span></header>
        <ul>{domainCases.map((item) => {
          const membership = documentById.get(item.fields.belongsTo);
          const searchText = `${item.id} ${item.title} ${membership?.title ?? ''} ${JSON.stringify(item.fields)}`;
          return <li data-case-row data-domain={domain.id} data-search={searchText} data-filters={JSON.stringify({ source: item.source, status: item.status, ...item.fields })}>
            <div><small>{item.id} · {item.source} · {item.status}</small><a href={`../cases/${safeName(item.id)}.html`}>{item.title}</a></div><span>{membership?.title ?? item.fields.belongsTo}</span>
          </li>;
        })}</ul>
      </section>)}</div>
      <p class="empty-results" id="empty-results" hidden>条件に一致するケースはありません。</p>
    </div>
  </div>
  <script is:inline src="../assets/search.js"></script>
</AppLayout>
