---
import AppLayout from '../components/AppLayout.astro';
import DomainCard from '../components/DomainCard.astro';
import { documents } from '../lib/catalog.ts';

const domains = documents.filter((document) => document.parent === undefined);
---
<AppLayout title="ドメイン" section="catalog">
  <div class="catalog-intro">
    <h1>ドメインから確認内容をたどる</h1>
    <label class="global-search"><span>検索</span><input id="search" type="search" placeholder="ドメイン、featureを検索" /></label>
    <strong><span>{documents.length}</span>文書</strong>
  </div>
  <div class="domain-overviews">{domains.map((domain) => <DomainCard domain={domain} />)}</div>
  <script is:inline src="assets/search.js"></script>
</AppLayout>
