---
import type { KnowledgeDocument } from '../../../../src/model.ts';
import { casesBelow, documents, safeName } from '../lib/catalog.ts';

const { domain } = Astro.props as { domain: KnowledgeDocument };
const domainCases = casesBelow(domain);
const features = documents.filter((document) => document.parent === domain.id);
const summary = domain.body.trim().split(/\r?\n/u).find((line) => line.trim() && !line.startsWith('#')) ?? '';
const searchText = [domain.title, summary, ...features.map((feature) => feature.title)].join(' ');
---
<section class="domain-overview" data-domain-overview={domain.id} data-search={searchText}>
  <header><h2><a href={`documents/${safeName(domain.id)}.html`}>{domain.title}</a></h2><span>{domainCases.length}ケース</span></header>
  <p>{summary}</p>
  {features.length > 0 && <ul>{features.map((feature) => <li><a href={`documents/${safeName(feature.id)}.html`}>{feature.title}</a><small>{casesBelow(feature).length}ケース</small></li>)}</ul>}
</section>
