{
  "title": "test-manager.yaml",
  "description": "Structure of a test-manager project configuration. Rules that relate several values (document kinds, requiredWhen targets, required/requiredWhen exclusivity, reserved field names) are checked by `test-manager check`, not by this schema.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "idPattern": {
      "type": "string",
      "minLength": 1
    },
    "discovery": {
      "type": "object",
      "properties": {
        "documents": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!(?:0|[1-9][0-9]*)$)"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "manual": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "vitest": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "playwright": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "storybook": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "manual"
                ]
              },
              {
                "required": [
                  "vitest"
                ]
              },
              {
                "required": [
                  "playwright"
                ]
              },
              {
                "required": [
                  "storybook"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "documents",
        "sources"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "targetKinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "required",
                  "targetKinds"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "description",
              "parent"
            ],
            "additionalProperties": false
          }
        },
        "displayOrder": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "kinds"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "reference"
                  },
                  "targetKinds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type",
                  "targetKinds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "reference-list"
                  },
                  "targetKinds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "minItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "uniqueItems": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type",
                  "targetKinds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "enum"
                  },
                  "values": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "playwrightTag": {
                    "type": "string"
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type",
                  "values"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "integer-enum"
                  },
                  "values": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type",
                  "values"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "text"
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "classification",
                      "detail"
                    ]
                  },
                  "requiredWhen": {
                    "$ref": "#/$defs/RequiredWhen"
                  },
                  "type": {
                    "type": "string",
                    "const": "text-list"
                  },
                  "minItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "uniqueItems": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "required",
                  "placement",
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "idPattern",
    "discovery",
    "documents",
    "case"
  ],
  "additionalProperties": false,
  "$defs": {
    "RequiredWhen": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            }
          },
          "required": [
            "field",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "in": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "field",
            "in"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
